# SQLite is used for local dev so you can run this with zero setup.
# Swap to Postgres for production: DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# Meta (Facebook/Instagram) Pixel - get this from Meta Events Manager after
# creating a Dataset there. Must be prefixed NEXT_PUBLIC_ since it's read
# in the browser. Leave unset to disable all Meta tracking.
NEXT_PUBLIC_META_PIXEL_ID=""

# Secret used to verify that /api/cron/application-reminders is actually
# being called by Vercel Cron and not by anyone else. Vercel automatically
# sends this as a Bearer token when it invokes the scheduled job, as long as
# this exact env var is set. Generate any random string for this value.
CRON_SECRET=""
