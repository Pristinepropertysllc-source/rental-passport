# SQLite is used for local dev so you can run this with zero setup.
# Swap to Postgres for production: DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# Meta (Facebook/Instagram) Pixel - get this from Meta Events Manager after
# creating a Dataset there. Must be prefixed NEXT_PUBLIC_ since it's read
# in the browser. Leave unset to disable all Meta tracking.
NEXT_PUBLIC_META_PIXEL_ID=""
